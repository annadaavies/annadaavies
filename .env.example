# Copy to `.env` (which is gitignored) and fill in.
# gifos calls load_dotenv() at import, so a .env in the working dir is picked up.

# Fine-grained PAT: Repository access = All repositories,
# Repository permissions = Contents: Read-only
GITHUB_TOKEN=

# Only needed if you want to upload the gif to imgbb instead of committing it.
# Optional — the recommended flow commits output.gif to the repo directly.
IMGBB_API_KEY=
